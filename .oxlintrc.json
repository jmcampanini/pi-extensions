{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "overrides": [
    {
      "files": ["**/tests/*-test.ts"],
      "rules": {
        "typescript/no-floating-promises": [
          "error",
          {
            "allowForKnownSafeCalls": [
              { "from": "package", "package": "node", "name": ["describe", "it", "test"] }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["node_modules", ".sandbox", ".codex-web-search"]
}
